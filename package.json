{
  "name": "murmur-notes",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:runtime && vite --host 0.0.0.0",
    "build": "npm run prepare:runtime && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:model": "node scripts/test-model.mjs",
    "test:cloud": "node scripts/test-cloud.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.61.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
